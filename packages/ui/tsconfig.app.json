{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@terrarium/architecture-visualizer": ["../architecture-visualizer/src/index.ts"],
      "@terrarium/engine": ["../engine/src/index.ts"],
      "@terrarium/observation": ["../observation/src/index.ts"],
      "@terrarium/fixtures": ["../fixtures/index.ts"]
    }
  },
  "include": ["src"]
}
