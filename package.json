{
  "name": "terrarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @terrarium/ui dev",
    "architecture:scan": "pnpm --filter @terrarium/architecture-visualizer scan",
    "architecture:check": "pnpm --filter @terrarium/architecture-visualizer check",
    "build": "pnpm --filter @terrarium/ui build",
    "preview": "pnpm --filter @terrarium/ui preview",
    "typecheck": "tsc -p packages/engine/tsconfig.json && tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.app.json && tsc -p packages/ui/tsconfig.node.json && tsc -p packages/architecture-visualizer/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "coverage": "vitest run --coverage",
    "batch": "pnpm --filter @terrarium/runner batch",
    "country-fuzz": "pnpm --filter @terrarium/runner country-fuzz",
    "stability": "pnpm --filter @terrarium/runner stability",
    "export-feedback": "pnpm --filter @terrarium/runner export-feedback",
    "export-share": "tsx tools/measure-export-share.ts",
    "neutral-rate": "tsx tools/measure-neutral-rate.ts",
    "yield-curve": "tsx tools/measure-yield-curve.ts",
    "inflation-expectations": "tsx tools/measure-inflation-expectations.ts",
    "institution-costs": "tsx tools/measure-institution-costs.ts",
    "capital-returns": "tsx tools/measure-capital-returns.ts",
    "wealth": "tsx tools/measure-wealth.ts",
    "capital-ownership": "tsx tools/measure-capital-ownership.ts",
    "investment-delivery": "tsx tools/measure-investment-delivery.ts",
    "composition": "tsx tools/measure-composition.ts",
    "class-structure": "tsx tools/measure-class-structure.ts",
    "labour-market": "tsx tools/measure-labour-market.ts",
    "agriculture": "tsx tools/measure-agriculture.ts",
    "minimum-wage": "tsx tools/measure-minimum-wage.ts",
    "bless": "tsx tools/bless.ts",
    "diff-state": "tsx tools/diff-state.ts",
    "replay": "tsx tools/replay-save.ts",
    "debt-baselines": "tsx tools/measure-debt-baselines.ts",
    "inheritance": "tsx tools/measure-inheritance.ts",
    "fdi": "tsx tools/measure-fdi.ts",
    "ranges": "tsx tools/indicator-ranges.ts",
    "events": "tsx tools/measure-events.ts",
    "currency": "tsx tools/measure-currency.ts",
    "surplus": "tsx tools/measure-surplus.ts",
    "hdi-analysis": "tsx tools/hdi-analysis.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
