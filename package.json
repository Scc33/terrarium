{
  "name": "terrarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @terrarium/ui dev",
    "build": "pnpm --filter @terrarium/ui build",
    "preview": "pnpm --filter @terrarium/ui preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.app.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "batch": "pnpm --filter @terrarium/runner batch",
    "bless": "tsx tools/bless.ts",
    "diff-state": "tsx tools/diff-state.ts",
    "ranges": "tsx tools/indicator-ranges.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "tsx": "^4.23.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
